# Copy to `.env` and fill in. `.env` is gitignored and must stay that way.
# Nothing in this file is read at import time except through src/config.py,
# which never caches a credential and never logs one.

# --- Dhan (price history + optional live execution) -------------------------
# Data pulls need these. The research pipeline runs from the archive WITHOUT
# them — a missing/broken token blocks new fetches only (§5).
DHAN_CLIENT_ID=
DHAN_API_KEY=
DHAN_API_SECRET=
DHAN_TOTP_SEED=

# Order APIs require a registered static IP (§14). The live adapter preflights
# this against the current WAN IP and refuses to trade on mismatch.
DHAN_REGISTERED_IP=

# --- LLM (§15) --------------------------------------------------------------
# LLM_MODE=stub is the default and needs no key: extraction/review return
# deterministic no-ops and the whole system still runs.
LLM_MODE=stub
ANTHROPIC_API_KEY=

# --- §0 fill-ins ------------------------------------------------------------
# All have defaults in src/config.py; set here to override.
CAPITAL_INR=1000000
UNIVERSE_TIER=smallcap_inclusive
BENCHMARK=NIFTY_500_TRI
MAX_POSITION_PCT=4.0
MAX_SECTOR_PCT=25.0
MIN_POSITIONS=25
REBALANCE_FREQ=quarterly
HISTORY_START=2010-04-01

# --- §9 liquidity -----------------------------------------------------------
MAX_PARTICIPATION_PCT=5.0

# --- §14 execution safety ---------------------------------------------------
# Leave False. Setting True still requires an interactive typed confirmation
# per rebalance that echoes notional and order count.
LIVE_ENABLED=False

# --- fetch politeness (§5) --------------------------------------------------
FETCH_MIN_INTERVAL_S=2.0
FETCH_MAX_RETRIES=4
